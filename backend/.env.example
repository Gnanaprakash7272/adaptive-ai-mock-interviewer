SUPABASE_URL="YOUR_SUPABASE_URL_HERE"
SUPABASE_KEY="YOUR_SUPABASE_KEY_HERE"
# Supabase Session Pooler URL (port 5432, aws-0-<region>.pooler.supabase.com:5432/postgres)
# Note: Remove [ ] brackets around password and URL-encode special chars (@ -> %40, # -> %23)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Set to true if you want local development to fall back to in-memory checkpointer if Postgres is unreachable
ALLOW_MEMORY_CHECKPOINTER=false
JWT_SECRET_KEY="YOUR_JWT_SECRET_HERE"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="60"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_FALLBACKS=gemini-1.5-flash
# Optional faster provider. Set AI_PROVIDER=groq to use Groq for interview calls.
# Set AI_PROVIDER_FALLBACK=gemini to fall back to Gemini when Groq is unavailable.
AI_PROVIDER=gemini
AI_PROVIDER_FALLBACK=
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"
GROQ_MODEL=llama-3.3-70b-versatile
# SMTP settings for signup welcome and password-reset emails
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="your-email@example.com"
SMTP_PASSWORD="your-app-password"
FROM_EMAIL="your-email@example.com"
LANGGRAPH_STRICT_MSGPACK=true
# Optional Redis URL for distributed rate limiting (leave empty for in-memory)
REDIS_URL="redis://localhost:6379"
# GEMINI_API_KEY_2="YOUR_SECOND_KEY_FROM_A_DIFFERENT_GOOGLE_ACCOUNT"
# GEMINI_API_KEY_3="YOUR_THIRD_KEY_FROM_A_DIFFERENT_GOOGLE_ACCOUNT"
