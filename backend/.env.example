SUPABASE_URL="YOUR_SUPABASE_URL_HERE"
SUPABASE_KEY="YOUR_SUPABASE_KEY_HERE"
# Supabase Session Pooler URL (port 5432, aws-0-<region>.pooler.supabase.com:5432/postgres)
# Note: Remove [ ] brackets around password and URL-encode special chars (@ -> %40, # -> %23)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Set to true if you want local development to fall back to in-memory checkpointer if Postgres is unreachable
ALLOW_MEMORY_CHECKPOINTER=false
JWT_SECRET_KEY="YOUR_JWT_SECRET_HERE"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="60"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash
LANGGRAPH_STRICT_MSGPACK=true
# GEMINI_API_KEY_2="YOUR_SECOND_KEY_FROM_A_DIFFERENT_GOOGLE_ACCOUNT"
# GEMINI_API_KEY_3="YOUR_THIRD_KEY_FROM_A_DIFFERENT_GOOGLE_ACCOUNT"
